'use strict';
const $=id=>document.getElementById(id),NS='http://www.w3.org/2000/svg',clone=x=>JSON.parse(JSON.stringify(x)),KEY='scut-mit-style-editor-v1';
const edgeKey=(a,b)=>JSON.stringify([a,b].sort());
const defaultBackground=()=>({src:REFERENCE_IMAGE,name:'五山校区参考地图 · ©ChienchouSu',x:0,y:0,width:820,height:820*2363/1665,isDefault:true});
let data=clone(INITIAL),background=defaultBackground(),mode='move',selected=null,first=null,history=[],future=[],zoom=1,pan={x:0,y:0},drag=null,frame={x:0,y:0,w:820,h:640},notice='',metricsCache=null;
function validate(value){
  if(value?.schema!=='scut-wushan-v1'||!Array.isArray(value.nodes)||!Array.isArray(value.edges)||value.nodes.length>1000||value.edges.length>20000)throw Error('需要 scut-wushan-v1 JSON，最多1000节点、20000边');
  const ids=new Set();
  for(const n of value.nodes){if(typeof n.id!=='string'||!n.id.trim()||n.id.length>60||ids.has(n.id)||typeof n.name!=='string'||n.name.length>100||!Number.isFinite(n.x)||!Number.isFinite(n.y)||Math.abs(n.x)>1e6||Math.abs(n.y)>1e6||!['building','plaza','zone'].includes(n.kind||'building'))throw Error('节点编号、名称、坐标或类型无效');ids.add(n.id);for(const k of ['colleges','disciplines','note'])if(n[k]!==undefined&&typeof n[k]!=='string')throw Error('学院、学科、备注须为文本')}
  const pairs=new Set();for(const e of value.edges){if(typeof e.a!=='string'||typeof e.b!=='string'||e.a===e.b||!ids.has(e.a)||!ids.has(e.b)||pairs.has(edgeKey(e.a,e.b)))throw Error('存在无效或重复连线');pairs.add(edgeKey(e.a,e.b))}
  return clone(value);
}
function validateBackground(bg){if(!bg)return null;if(typeof bg.src!=='string'||!/^data:image\/(png|jpeg|webp);base64,[a-z0-9+/=]+$/i.test(bg.src)||bg.src.length>12000000||!['x','y','width','height'].every(k=>Number.isFinite(bg[k]))||bg.width<=0||bg.height<=0||bg.width>1e6||bg.height>1e6)throw Error('底图无效（仅支持PNG/JPEG/WebP）');return clone(bg)}
try{const saved=localStorage.getItem(KEY);if(saved){const v=JSON.parse(saved);data=validate(v.graph);background=validateBackground(v.background);if(!background&&!v.defaultMapRevision)background=defaultBackground();notice='已读取本机修改。'}}catch{notice='本机存档未能读取，已载入用户确认的原始拓扑。'}
function state(){return{graph:clone(data),background:clone(background),defaultMapRevision:1}}
function checkpoint(){history.push(state());if(history.length>80)history.shift();future=[]}
function message(t){notice=t;$('saved').textContent=t}
function save(){metricsCache=null;try{localStorage.setItem(KEY,JSON.stringify(state()));message('已保存到本机 · '+new Date().toLocaleTimeString('zh-CN')+' · 建议导出备份')}catch{message('浏览器空间不足或禁用存储；请导出修改，底图可用“导出含底图项目”备份。')}}
function mark(tag,attrs={},text){const n=document.createElementNS(NS,tag);for(const[k,v]of Object.entries(attrs))n.setAttribute(k,v);if(text!==undefined)n.textContent=text;return n}
function calc(){if(metricsCache)return metricsCache;const adj=new Map(data.nodes.map(n=>[n.id,[]]));for(const e of data.edges){adj.get(e.a).push(e.b);adj.get(e.b).push(e.a)}let reciprocal=0,components=0;const seen=new Set();for(const start of adj.keys()){const d=new Map([[start,0]]),queue=[start];for(let i=0;i<queue.length;i++)for(const next of adj.get(queue[i]))if(!d.has(next)){d.set(next,d.get(queue[i])+1);queue.push(next)}if(!seen.has(start)){components++;for(const v of d.keys())seen.add(v)}for(const distance of d.values())if(distance)reciprocal+=1/distance}const n=adj.size;return metricsCache={nodes:n,edges:data.edges.length,components,efficiency:n>1?reciprocal/(n*(n-1)):0}}
function fitFrame(){if(background){frame={x:background.x,y:background.y,w:background.width,h:background.height}}else if(data.nodes.length){const xs=data.nodes.map(n=>n.x),ys=data.nodes.map(n=>n.y);const x=Math.min(0,...xs)-35,y=Math.min(0,...ys)-35;frame={x,y,w:Math.max(820,Math.max(...xs)+65-x),h:Math.max(640,Math.max(...ys)+65-y)}}else frame={x:0,y:0,w:820,h:640};$('map').setAttribute('viewBox',`${frame.x} ${frame.y} ${frame.w} ${frame.h}`);for(const[k,v]of Object.entries({x:frame.x,y:frame.y,width:frame.w,height:frame.h}))$('paper').setAttribute(k,v);zoom=1;pan={x:0,y:0};transform()}
function transform(){$('scene').setAttribute('transform',`translate(${pan.x} ${pan.y}) scale(${zoom})`)}
function displayLabel(n){return n.id}
function paint(){
  const by=new Map(data.nodes.map(n=>[n.id,n]));$('lines').replaceChildren();$('points').replaceChildren();
  if(background){$('photo').setAttribute('href',background.src);for(const[k,v]of Object.entries({x:background.x,y:background.y,width:background.width,height:background.height}))$('photo').setAttribute(k,v)}else $('photo').removeAttribute('href');$('base').style.opacity=$('opacity').value;
  for(const e of data.edges){const a=by.get(e.a),b=by.get(e.b),g=mark('g',{'data-edge':edgeKey(e.a,e.b)});for(const cl of ['visible','hit'])g.append(mark('line',{x1:a.x,y1:a.y,x2:b.x,y2:b.y,class:cl}));g.append(mark('title',{},e.a+' ↔ '+e.b));g.addEventListener('pointerdown',ev=>{if(ev.button!==0)return;if(mode==='erase'){ev.stopPropagation();edge(e.a,e.b,false)}});$('lines').append(g)}
  for(const n of data.nodes){const g=mark('g',{'data-id':n.id,class:selected===n.id||first===n.id?'selected':'','aria-label':n.id+' '+n.name});g.append(mark('title',{},n.id+' '+n.name));g.append(n.kind==='plaza'?mark('rect',{x:n.x-4.5,y:n.y-4.5,width:9,height:9}):mark('circle',{cx:n.x,cy:n.y,r:4.5}));g.append(mark('text',{x:n.x+(Number(n.labelDx)||0),y:n.y+(Number(n.labelDy)||17),'text-anchor':'middle'},displayLabel(n)));if($('showNames').checked)g.append(mark('text',{x:n.x,y:n.y+30,'text-anchor':'middle',class:'name-label'},n.name));g.addEventListener('pointerdown',e=>onNode(e,n));$('points').append(g)}
  $('lines').style.display=$('showEdges').checked?'':'none';$('points').style.display=$('showNodes').checked?'':'none';transform();
}
function inspect(){const n=data.nodes.find(n=>n.id===selected);$('empty').hidden=!!n;$('editor').hidden=!n;if(n){$('nodeId').value=n.id;$('nodeName').value=n.name;$('nodeKind').value=n.kind||'building';$('colleges').value=n.colleges||'';$('disciplines').value=n.disciplines||'';$('nodeNote').value=n.note||''}$('positionNote').textContent=n?`坐标：${n.x.toFixed(2)}, ${n.y.toFixed(2)}`:'';for(const id of ['edgeA','edgeB']){const old=$(id).value;$(id).replaceChildren(...data.nodes.map(n=>new Option(n.id+' '+n.name,n.id)));if(data.nodes.some(n=>n.id===old))$(id).value=old}}
function draw(){$('edgeMessage').textContent='';$('editMessage').textContent='';paint();inspect();const stats=calc();$('stats').replaceChildren();for(const[label,value]of [['节点',stats.nodes],['连线',stats.edges],['连通分量',stats.components],['全局效率',stats.efficiency.toFixed(3)]]){const d=document.createElement('div'),b=document.createElement('b');d.textContent=label;b.textContent=value;d.append(b);$('stats').append(d)}document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.mode===mode));$('undo').disabled=!history.length;$('redo').disabled=!future.length;$('mapNote').textContent=background?.isDefault?'默认使用之前找到的五山地图，保留原图比例与署名。节点仍沿用原始坐标，可拖动校正位置。':background?'已关联本地底图：'+background.name+'。图片按当前画布坐标范围放置；对应关系可用拖动校正。':'原 JSON 未附底图，保留原始坐标。可载入对应图片；五山总平面单独供参考。';nodeList();hint()}
function hint(){const text={move:'拖动圆点调整位置；拖动空白处平移，滚轮可缩放。点击节点在右侧编辑。',node:'点击画布放置新节点，然后在右侧编辑编号、名称和类别。',edge:first?'已选 '+first+'，请点击另一个实际接触的楼栋节点。':'依次点击两个实际接触的楼栋节点建立连线。',erase:'点击需要删除的连线；也可在右侧选择端点断开。'};$('hint').textContent=text[mode]}
function nodeList(){const query=$('search').value.trim().toLowerCase(),list=data.nodes.filter(n=>(n.id+' '+n.name+' '+(n.colleges||'')).toLowerCase().includes(query));$('nodeList').replaceChildren();for(const n of list){const b=document.createElement('button');b.type='button';b.textContent=n.id+' · '+n.name;b.setAttribute('aria-pressed',selected===n.id);b.onclick=()=>{selected=n.id;mode='move';first=null;draw();const cx=frame.x+frame.w/2,cy=frame.y+frame.h/2;pan={x:cx-n.x*zoom,y:cy-n.y*zoom};transform()};$('nodeList').append(b)}if(!list.length)$('nodeList').textContent='没有匹配节点'}$('search').oninput=nodeList;
function coord(e){const p=$('map').createSVGPoint();p.x=e.clientX;p.y=e.clientY;return p.matrixTransform($('scene').getScreenCTM().inverse())}
function onNode(e,n){if(e.button!==0)return;e.stopPropagation();e.preventDefault();if(mode==='node')return;selected=n.id;if(mode==='edge'){if(first&&first!==n.id){edge(first,n.id,true);first=null}else first=n.id;draw();return}if(mode==='move'){const p=coord(e);drag={type:'node',id:n.id,dx:p.x-n.x,dy:p.y-n.y,before:state(),moved:false};$('map').setPointerCapture(e.pointerId)}draw()}
function edge(a,b,add){if(!a||!b||a===b||!data.nodes.some(n=>n.id===a)||!data.nodes.some(n=>n.id===b)){$('edgeMessage').textContent='请选择两个不同的有效节点。';return}const exists=data.edges.some(e=>edgeKey(e.a,e.b)===edgeKey(a,b));if(exists===add){$('edgeMessage').textContent=add?'这两个节点已经相连。':'这两个节点没有连线。';return}checkpoint();if(add)data.edges.push({a,b,confirmed:true});else data.edges=data.edges.filter(e=>edgeKey(e.a,e.b)!==edgeKey(a,b));save();draw();$('edgeMessage').textContent=add?`已连接 ${a} ↔ ${b}`:`已断开 ${a} ↔ ${b}`}
$('map').addEventListener('pointerdown',e=>{if(e.button!==0)return;if(mode==='node'){const p=coord(e);checkpoint();let i=1;while(data.nodes.some(n=>n.id==='N'+i))i++;selected='N'+i;data.nodes.push({id:selected,name:'新增节点',kind:'building',x:p.x,y:p.y,colleges:'',disciplines:'',note:'用户手动标注'});save();mode='move';draw();$('nodeId').focus();$('nodeId').select()}else if(mode==='move'){selected=null;draw();drag={type:'pan',x:e.clientX,y:e.clientY,pan:{...pan}};$('map').setPointerCapture(e.pointerId)}});
$('map').addEventListener('pointermove',e=>{if(!drag)return;if(drag.type==='node'){const p=coord(e),n=data.nodes.find(n=>n.id===drag.id);n.x=p.x-drag.dx;n.y=p.y-drag.dy;drag.moved=true;paint();$('positionNote').textContent=`坐标：${n.x.toFixed(2)}, ${n.y.toFixed(2)}`}else{const m=$('map').getScreenCTM();pan={x:drag.pan.x+(e.clientX-drag.x)/m.a,y:drag.pan.y+(e.clientY-drag.y)/m.d};transform()}});
function finish(){if(drag?.type==='node'&&drag.moved){history.push(drag.before);if(history.length>80)history.shift();future=[];save();draw()}drag=null}$('map').addEventListener('pointerup',finish);$('map').addEventListener('pointercancel',finish);
function setZoom(z,center){const next=Math.max(.3,Math.min(12,z)),cx=center?.x??frame.x+frame.w/2,cy=center?.y??frame.y+frame.h/2;pan.x=cx-(cx-pan.x)*next/zoom;pan.y=cy-(cy-pan.y)*next/zoom;zoom=next;transform()}
$('map').addEventListener('wheel',e=>{e.preventDefault();const p=$('map').createSVGPoint();p.x=e.clientX;p.y=e.clientY;setZoom(zoom*(e.deltaY<0?1.12:1/1.12),p.matrixTransform($('map').getScreenCTM().inverse()))},{passive:false});$('plus').onclick=()=>setZoom(zoom*1.25);$('minus').onclick=()=>setZoom(zoom/1.25);$('fit').onclick=fitFrame;document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;first=null;draw()});
$('editor').onsubmit=e=>{e.preventDefault();const n=data.nodes.find(n=>n.id===selected);if(!n)return;const old=n.id,id=$('nodeId').value.trim();if(!id||id.length>60){$('editMessage').textContent='编号需为1—60个字符。';return}if(data.nodes.some(v=>v!==n&&v.id===id)){$('editMessage').textContent='已有编号 '+id+'，请使用不同编号。';return}checkpoint();n.id=id;n.name=$('nodeName').value.trim()||id;n.kind=$('nodeKind').value;n.colleges=$('colleges').value.trim();n.disciplines=$('disciplines').value.trim();n.note=$('nodeNote').value;for(const e of data.edges){if(e.a===old)e.a=id;if(e.b===old)e.b=id}if(first===old)first=id;selected=id;save();draw();$('editMessage').textContent=old===id?'节点信息已保存。':`已将 ${old} 改为 ${id}，关联连线已同步更新。`};
$('deleteNode').onclick=()=>{if(!selected)return;checkpoint();data.nodes=data.nodes.filter(n=>n.id!==selected);data.edges=data.edges.filter(e=>e.a!==selected&&e.b!==selected);if(first===selected)first=null;selected=null;save();draw()};$('addEdge').onclick=()=>edge($('edgeA').value,$('edgeB').value,true);$('removeEdge').onclick=()=>edge($('edgeA').value,$('edgeB').value,false);
function restore(from,to){if(!from.length)return;to.push(state());const previous=from.pop();data=previous.graph;background=previous.background;selected=null;first=null;drag=null;save();fitFrame();draw()}$('undo').onclick=()=>restore(history,future);$('redo').onclick=()=>restore(future,history);
for(const[id,msg,fn]of [['clearEdges','清空全部连线？节点仍保留，可撤销。',()=>data.edges=[]],['clearNodes','清空全部节点与连线？可撤销。',()=>{data.nodes=[];data.edges=[]}],['reset','恢复用户确认的15节点8边原始拓扑？当前修改可撤销；自选底图保留。',()=>data=clone(INITIAL)]])$(id).onclick=()=>{if(confirm(msg)){checkpoint();fn();selected=null;first=null;save();fitFrame();draw()}};
for(const id of ['showEdges','showNodes','showNames','opacity'])$(id).oninput=paint;
function download(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),2000)}
function topology(){return{...clone(data),edges:data.edges.map(e=>({...e,confirmed:true})),schema:'scut-wushan-v1',exportedAt:new Date().toISOString(),topologyStatus:'用户确认拓扑；编辑后的边由用户按楼栋接触规则维护'}}
$('export').onclick=()=>{download(new Blob([JSON.stringify(topology(),null,2)],{type:'application/json;charset=utf-8'}),'华工五山拓扑-'+new Date().toLocaleDateString('sv-SE')+'.json');message('已导出图结构，包含节点全部属性和边；自选底图可另用“导出含底图项目”。')};
$('projectExport').onclick=()=>download(new Blob([JSON.stringify({schema:'scut-wushan-project-v1',graph:topology(),background},null,2)],{type:'application/json;charset=utf-8'}),'华工五山编辑项目.json');
$('import').onclick=()=>$('file').click();$('file').onchange=async()=>{const file=$('file').files[0];if(!file)return;try{if(file.size>15000000)throw Error('文件不能超过15MB');const v=JSON.parse(await file.text());const graph=validate(v.schema==='scut-wushan-project-v1'?v.graph:v),bg=v.schema==='scut-wushan-project-v1'?validateBackground(v.background):background;checkpoint();data=graph;background=bg;selected=null;first=null;save();fitFrame();draw();message('已导入 '+data.nodes.length+' 节点、'+data.edges.length+' 条边；可撤销。')}catch(e){message('导入失败：'+e.message)}$('file').value=''};
$('mapImport').onclick=()=>$('mapFile').click();$('mapFile').onchange=async()=>{const file=$('mapFile').files[0];if(!file)return;try{if(!['image/png','image/jpeg','image/webp'].includes(file.type)||file.size>8000000)throw Error('请选择8MB以内的PNG、JPEG或WebP');const src=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)});await new Promise((resolve,reject)=>{const image=new Image();image.onload=resolve;image.onerror=()=>reject(Error('图片无法读取'));image.src=src});checkpoint();background={src,name:file.name,x:frame.x,y:frame.y,width:frame.w,height:frame.h};save();draw();message('已载入底图，原始节点坐标未变；可拖动节点进行配准。')}catch(e){message('底图载入失败：'+e.message)}$('mapFile').value=''};
$('restoreMap').onclick=()=>{checkpoint();background=defaultBackground();save();fitFrame();draw()};
$('removeMap').onclick=()=>{if(!background)return;checkpoint();background=null;save();draw()};
$('oldBackup').onclick=()=>{let entries={};try{for(const k of ['scut-graph-v1','scut-wushan-buildings-v2']){const value=localStorage.getItem(k);if(value)entries[k]=JSON.parse(value)}}catch(e){message('读取旧版存档失败：'+e.message);return}if(!Object.keys(entries).length){message('此浏览器没有旧版存档。');return}download(new Blob([JSON.stringify(entries,null,2)],{type:'application/json'}),'华工旧版浏览器存档备份.json')};
function svgBlob(){const svg=$('map').cloneNode(true);svg.querySelector('#scene').removeAttribute('transform');svg.querySelectorAll('title').forEach(n=>n.remove());svg.querySelectorAll('.hit').forEach(n=>n.remove());svg.querySelectorAll('#lines .visible').forEach(n=>{n.setAttribute('stroke','#168eb4');n.setAttribute('stroke-width','2');n.setAttribute('stroke-opacity','.85')});svg.querySelectorAll('#points circle,#points rect').forEach(n=>{n.setAttribute('fill','#fff');n.setAttribute('stroke','#086b9d');n.setAttribute('stroke-width','1.6')});svg.querySelectorAll('#points text').forEach(n=>{n.setAttribute('font-size',n.classList.contains('name-label')?'9':'11');n.setAttribute('font-family','Arial,Microsoft YaHei,sans-serif');n.setAttribute('fill','#083c5b');n.setAttribute('text-anchor','middle');n.setAttribute('stroke','#fff');n.setAttribute('stroke-width','3');n.setAttribute('paint-order','stroke')});svg.setAttribute('width',Math.round(frame.w));svg.setAttribute('height',Math.round(frame.h));return new Blob([new XMLSerializer().serializeToString(svg)],{type:'image/svg+xml;charset=utf-8'})}
$('exportSVG').onclick=()=>download(svgBlob(),'华工五山拓扑.svg');$('exportPNG').onclick=()=>{const url=URL.createObjectURL(svgBlob()),image=new Image();image.onload=()=>{try{const canvas=document.createElement('canvas'),scale=Math.min(2,4096/Math.max(frame.w,frame.h));canvas.width=Math.max(1,Math.round(frame.w*scale));canvas.height=Math.max(1,Math.round(frame.h*scale));canvas.getContext('2d').drawImage(image,0,0,canvas.width,canvas.height);canvas.toBlob(blob=>{if(blob){download(blob,'华工五山拓扑.png');message('已导出PNG。')}else message('PNG导出失败')})}catch(e){message('PNG导出失败：'+e.message)}finally{URL.revokeObjectURL(url)}};image.onerror=()=>{URL.revokeObjectURL(url);message('PNG导出失败，请尝试SVG。')};image.src=url};
document.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName))return;if(e.key==='Escape'){first=null;mode='move';draw()}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'){e.preventDefault();if(e.shiftKey)$('redo').click();else $('undo').click()}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='y'){e.preventDefault();$('redo').click()}});
$('referenceImage').src=REFERENCE_IMAGE;$('referenceOpen').onclick=()=>$('referenceDialog').showModal();$('referenceClose').onclick=()=>$('referenceDialog').close();
window.scutEditor={snapshot:()=>clone(data),metrics:calc,validate,project:state};
fitFrame();draw();message(notice||'已载入用户确认的15节点、8条边。');
